<?xml version="1.0" encoding="utf-8"?>
<!--
    Strings mapped through SystemRestrictions.kt are accessed dynamically via
    Resources.getIdentifier, so R8 / ProGuard's resource shrinker doesn't see
    they're used and would otherwise strip them from release builds.
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@string/disallow_*,@string/allow_*,@string/ensure_*,@string/no_*" />
